.env
.env.local
.env.*.local
node_modules/
.next/
packages/*/node_modules/
*.tgz
!kognitos-lattice-*.tgz
.vercel
.DS_Store

# Supabase CLI runtime artifacts (regenerated on `supabase start`)
supabase/.branches/
supabase/.temp/

# Generated outputs from scripts/ utilities (write plans, audit snapshots,
# publish logs). These are local-only — committing them leaks state.
scripts/.*.json
.env.cloud

# Monday data backup snapshots (real customer data — keep local, do not commit)
monday-backup/
monday-backup-*/

# Brainstorming visual-companion sessions
.superpowers/

# Local-only working material: design exports, one-off spreadsheets, vendor
# API dumps, narrative drafts, and code superseded but kept for reference.
# None of it is source; committing it would put customer data and 600KB of
# design zips in the repo.
archive/
kognitos_api/
value_narrative/
v2-migration-data/
